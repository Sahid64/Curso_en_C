Algoritmo ubi_x_y
	Definir res, x1, x2, y1, y3, d Como Entero
	Escribir 'Introduce valor de x1'
	Leer x1
	Escribir 'Introduce valor de x2'
	Leer x2
	Escribir 'Introduce valor de y1'
	Leer y1
	Escribir 'Introduce valor de y2'
	Leer y2
	d <- raiz((x2-x1)^2+(y2-y1)^2)
	Escribir 'La distancia es de: ', d
FinAlgoritmo
