Algoritmo Tabla_de_multiplicar_4y5
	Definir i, tot Como Entero	
	Escribir "Tabla del 4:"
	i=1
	Repetir
		tot=4*i
		Escribir "4 * ", i, " = ", tot
		i=i+1
	Hasta Que i>10
	Escribir "Tabla del 5:"
	i=1
	Repetir
		tot=5*i
		Escribir "5 * ", i, " = ", tot
		i=i+1
	Hasta Que i>10
FinAlgoritmo
