Algoritmo num_mes
	Definir num Como Entero
	Escribir "Ingresa un numero de 1 al 12 "
	Leer num
	si num==1 Entonces
		Escribir "Enero tiene 31 dias"
	FinSi
	si num==2 Entonces
		Escribir "Febreo tiene 29 dias"
	FinSi
	si num==3 Entonces
		Escribir "Marzo tiene 31 dias"
	FinSi
	si num==4 Entonces
		Escribir "Abril tiene 30 dias"
	FinSi
	si num==5 Entonces
		Escribir "Mayo tiene 31 dias"
	FinSi
	si num==6 Entonces
		Escribir "Junio tiene 30 dias"
	FinSi
	si num==7 Entonces
		Escribir "Julio tiene 31 dias"
	FinSi
	si num==8 Entonces
		Escribir "Agosto tiene 31 dias"
	FinSi
	si num==9 Entonces
		Escribir "Septiembre tiene 30 dias"
	FinSi
	si num==10 Entonces
		Escribir "Octubre tiene 31 dias"
	FinSi
	si num==11 Entonces
		Escribir "Noviembre tiene 30 dias"
	FinSi
	si num==12 Entonces
		Escribir "Diciembre tiene 31 dias"
	FinSi
	si num<1 Entonces
		Escribir "Numero incorrecto"
	FinSi
	si num>12 Entonces
		Escribir "Numero incorrecto"
	FinSi
FinAlgoritmo
