Algoritmo Potencia
    Definir x, ye, tot Como Entero
    tot <- 1
    Escribir "Ingresa el valor de la potencia: "
    Leer ye
    Escribir "Ingresa el valor del número: "
    Leer x
    Para ini Desde 1 Hasta ye Hacer
        tot <- tot * x
    FinPara
    Escribir "El número elevado a la potencia es: ", tot
FinAlgoritmo
