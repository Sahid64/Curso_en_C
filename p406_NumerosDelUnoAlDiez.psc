Algoritmo NumerosDelUnoAlDiez
    Definir num Como Entero
    Escribir "Ingresa un número del 1 al 10: "
    Leer num
    Si num == 1 Entonces
        Escribir "Uno"
    Sino
        Si num == 2 Entonces
            Escribir "Dos"
        Sino
            Si num == 3 Entonces
                Escribir "Tres"
            Sino
                Si num == 4 Entonces
                    Escribir "Cuatro"
                Sino
                    Si num == 5 Entonces
                        Escribir "Cinco"
                    Sino
                        Si num == 6 Entonces
                            Escribir "Seis"
                        Sino
                            Si num == 7 Entonces
                                Escribir "Siete"
                            Sino
                                Si num == 8 Entonces
                                    Escribir "Ocho"
                                Sino
                                    Si num == 9 Entonces
                                        Escribir "Nueve"
                                    Sino
                                        Si num == 10 Entonces
                                            Escribir "Diez"
                                        Sino
                                            Escribir "El número ingresado es mayor al indicado"
                                        Fin Si
                                    Fin Si
                                Fin Si
                            Fin Si
                        Fin Si
                    Fin Si
                Fin Si
            Fin Si
        Fin Si
    Fin Si
Fin Algoritmo