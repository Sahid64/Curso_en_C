Algoritmo valores_xyz
	Definir x Como Real
	Definir ay Como Real
	Definir z Como Real
	Definir numero1 Como Real
	Definir numero2 Como Real
	Definir numero3 Como Real
	
	Escribir 'Ingresa el valor de x: '
	Leer x
	Escribir 'Ingresa el valor de y: '
	Leer ay
	Escribir 'Ingrese el valor de z: '
	Leer z
	
	numero1 = (x+5)/ay-2
	numero2 = Sen(x)+Cos(ay)/(raiz(2)-ay)
	numero3 = (x-3)^2 +2*(z-5)+3*(ay^3)-7
	
	Escribir 'El resultado de (x + 5)/ay -2 es de: ',numero1
	Escribir 'El resultado de Sen(x)+Cos(ay)/(raiz cuadrada 2-y es de: ',numero2
	Escribir 'El resultado de (x-3)^2 +2(z-5)+3y^3 -7 es de: ',numero3
FinAlgoritmo
