Algoritmo Promedio_de_3_materias
	Definir Matematicas Como Real
	Definir Ingles Como Real
	Definir Programacion Como Real
	Definir Promedio Como Real
	Escribir 'Ingresa la calificacion de Matematicas: '
	Leer Matematicas
	Escribir 'Ingresa la calificacion de Ingles: '
	Leer Ingles
	Escribir 'Ingresa la calificacion de Programacion: '
	Leer Programacion
	Promedio <- (Matematicas+Ingles+Programacion)/3
	Escribir 'El promdio de la calificacion es de: ', Promedio
FinAlgoritmo
