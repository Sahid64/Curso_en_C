Algoritmo Leer_la_velocidad
	Definir km_h Como Real
	Definir horas Como Real
	Definir distancia Como Real
	Escribir 'Ingresa la velocidad del automovil: ' 
	leer km_h
	Escribir 'Ingresa el tiempo transcurrido: '
	Leer horas
	distancia = km_h * horas
	Escribir 'La distancia recorrida es de: ' distancia 'km'
FinAlgoritmo
