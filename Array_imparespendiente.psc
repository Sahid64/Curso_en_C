Algoritmo Array_impares
	Definir numerosw, tot Como Entero
	Escribir "Numeracion ascedente de los numeros impares"
	numerosw=0
	Repetir
		numerosw= numerosw+1
		si numerosw<>numerosw/2 y umerosw<>numerosw/3 y numerosw<>numerosw/5 entero 
			tot= numerosw
			Escribir tot
		FinSi
	Hasta Que numerosw==90
FinAlgoritmo
