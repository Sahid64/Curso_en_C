Algoritmo Angulos_funciones_trigonometricas
	Definir angulos Como Real
	Definir seno Como Real
	Definir coseno Como Real
	Definir tangente Como Real
	
	Escribir 'Ingresa el numero de grados que deseas convertir: '
	Leer angulos
	
	seno = sen(angulos)
	coseno = cos(angulos)
	tangente = tan(angulos)
	
	Escribir 'El resultado es: '
	Escribir seno ' sin(Rad)'
	Escribir coseno ' cos(Rad)'
	Escribir tangente ' tan(Rad)'
FinAlgoritmo
