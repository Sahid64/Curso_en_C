Algoritmo area_de_cualquier_triangulo
	Definir area Como Real
	Definir sp Como Real
	Definir sp1 Como Real
	Definir sp2 Como Real
	Definir sp3 Como Real
	Escribir 'Ingresa el perimetro del primer lado: '
	Leer sp1
	Escribir 'Ingresa el perimetro del segundo lado: '
	Leer sp2
	Escribir 'Ingresa el perimetro del tercer lado: '
	Leer sp3
	area <- (sp1/2)*(sp2/2)*(sp3/2)
	Escribir 'El area del triangulo es de ', area
FinAlgoritmo
