Algoritmo Encontrar_valor_mayor
	Definir A, B, C Como Real
	Escribir 'Ingresa el primer valor:'
	Leer A
	Escribir 'Ingresa el segundo valor:'
	Leer B
	Escribir 'Ingresa el tercer valoe:'
	Leer C
	mayor <- A
	Si A>mayor Entonces
		mayor <- A
	FinSi
	Si B>mayor Entonces
		mayor <- B
	FinSi
	Si C>mayor Entonces
		mayor <- C
	FinSi
	Escribir 'El valor menor es: ', mayor
FinAlgoritmo
