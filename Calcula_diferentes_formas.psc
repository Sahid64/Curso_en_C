Algoritmo Calcula_diferentes_formas
	Definir numero1 Como Real
	Definir numero2 Como Real
	Definir resultado Como Real
	Definir suma Como Real
	Definir resta Como Real
	Definir  multiplicacion Como Real
	Definir  divicion Como Real
	Definir  potencia Como Real
	
	
	Escribir 'Ingresa el primer numero de la operacion que deseas realizar: '
	Leer numero1
	Escribir 'Ingresa el segundo numero de la operacion que deseas realizar: '
	Leer numero2
	
	suma = numero1+numero2
	resta = numero1-numero2
	multiplicacion = numero1*numero2
	divicion = numero1/numero2
	potencia = numero1^numero2
	
	Escribir 'El resultado es: ' 
	Escribir suma ' suma'
	Escribir resta ' resta'
	Escribir multiplicacion ' multiplicacion'
	Escribir divicion ' divicion'
	Escribir potencia ' potencia'
	
	
	
FinAlgoritmo
